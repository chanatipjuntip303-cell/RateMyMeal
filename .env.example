# Environment Variables for Rate My Meal
# Duplicate this file to .env

# Google Gemini API Key (Get one at https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Create a project at https://supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note: If your machine has multiple network cards (LAN + Wi-Fi),
# create .env.local and add:
# REACT_NATIVE_PACKAGER_HOSTNAME=<Your-WiFi-IP>
