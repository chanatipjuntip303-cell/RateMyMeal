{
  "expo": {
    "name": "Rate My Meal",
    "slug": "rate-my-meal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9E6A8"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cam.ratemymeal.app",
      "adaptiveIcon": {
        "backgroundColor": "#F9E6A8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share meal photos.",
          "cameraPermission": "The app accesses your camera to let you take meal photos.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "67cac31c-386e-45c7-9418-f6662c8f0050"
      }
    }
  }
}
